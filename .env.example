NODE_ENV=development
PORT=7171
WEB_ORIGIN=http://localhost:7172,http://127.0.0.1:7172,https://spotstrat.com,https://www.spotstrat.com
ALLOW_VERCEL_PREVIEWS=true
COOKIE_DOMAIN=

POSTGRES_USER=tradeai
POSTGRES_PASSWORD=troque
POSTGRES_DB=tradeai
DATABASE_URL=postgres://tradeai:troque@127.0.0.1:5432/tradeai

JWT_ACCESS_SECRET=troque
JWT_REFRESH_SECRET=troque

RETURN_OTP_IN_RESPONSE=true
PAPER_INITIAL_BALANCE=1000
TRIAL_HOURS=24
TRIAL_PROMPT_LIMIT=10
LAB_ROOT=/home/klaus/projects/tradeai/projeto_existente/data/backtest

# Chave da IA que transforma o prompt em receita de estratégia.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Stripe (Dashboard → Developers → API keys + Products + Webhooks)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price do produto de teste (ex.: R$ 0,30). Usado como fallback se o price específico faltar.
STRIPE_PRICE_ID=price_...
# Opcionais por plano/prazo (senão cai no STRIPE_PRICE_ID):
# STRIPE_PRICE_PAPER_1M=
# STRIPE_PRICE_PAPER_3M=
# STRIPE_PRICE_PAPER_6M=
# STRIPE_PRICE_PAPER_12M=
# STRIPE_PRICE_PRO_1M=
# STRIPE_PRICE_PRO_3M=
# STRIPE_PRICE_PRO_6M=
# STRIPE_PRICE_PRO_12M=
# STRIPE_PRICE_PRODUCTION_ID=
# Só para QA local sem Stripe: STRIPE_ALLOW_SIMULATE=true
STRIPE_ALLOW_SIMULATE=false
# Client ID OAuth do tipo Aplicativo da Web.
# Origens JavaScript: http://localhost:7172 e http://127.0.0.1:7172
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Aviso de pedido de produção. Sem webhook o pedido fica em apis/data/mail-outbox.log.
OWNER_EMAIL=
NOTIFY_WEBHOOK=

# Código de verificação e alarme. Chave em Resend → API Keys, só envio, restrita ao domínio.
# Com a chave preenchida, o código sai de noreply@ e não volta na resposta da API.
RESEND_API_KEY=
RESEND_SENDER_EMAIL=noreply@spotstrat.com
RESEND_SENDER_NAME=SpotStrat
RESEND_REPLY_TO=support@spotstrat.com
